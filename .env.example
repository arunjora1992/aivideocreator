# Copy to .env and fill in. The .env file is gitignored.

# ElevenLabs cloud TTS. Optional — leave blank to use the offline
# "piper" / "espeak" voiceover backends instead.
ELEVENLABS_API_KEY=

# Optional: authenticate the Claude CLI with an API key. Leave blank to sign in
# interactively with your Claude account via /login in the Claude tab.
ANTHROPIC_API_KEY=

# Which Remotion composition the GUI drives.
COMPOSITION_ID=starter
